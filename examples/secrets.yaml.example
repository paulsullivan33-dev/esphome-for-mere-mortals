# Copy this file to secrets.yaml (in the same folder as your
# device config) and fill in your own values. secrets.yaml is
# where ESPHome looks up every !secret reference. Never commit
# the real file to a public repository.
#
# The values below are invented placeholders for a fictional
# household. They protect nothing and reach nothing.

wifi_ssid: "Your Home WiFi Name"
wifi_password: "invent-a-password-of-your-own"

# The API encryption key must be 32 bytes, base64-encoded.
# Generate one with:  openssl rand -base64 32
# (ESPHome's wizard and dashboard generate one for you, too.)
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "invent-another-password"
